{
  "name": "hydrosense-desktop",
  "version": "1.0.0",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "cross-env VITE_DEV_SERVER=true concurrently -k \"vite\" \"tsup --watch\" \"wait-on tcp:5173 dist/main/main.cjs && electron .\"",
    "build": "tsup && vite build",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux deb AppImage",
    "package": "npm run build && electron-builder",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [],
  "author": {
    "name": "HydroSense",
    "email": "support@hydrosense.local"
  },
  "license": "ISC",
  "description": "Hydroponics monitoring and analysis desktop application.",
  "homepage": "https://hydrosense.local",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.6",
    "framer-motion": "^12.23.12",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.541.0",
    "marked": "^16.2.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.1.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.14",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "az.deepsense.hydrosense",
    "productName": "HydroSense",
    "artifactName": "HydroSense-${version}.${ext}",
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "extraMetadata": {
      "main": "dist/main/main.cjs"
    },
    "asarUnpack": [
      "**/*.node",
      "**/better-sqlite3/**"
    ],
    "compression": "maximum",
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "executableName": "hydrosense",
      "maintainer": "HydroSense <support@hydrosense.local>"
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "tsup": {
    "entry": {
      "main": "src/main/main.ts",
      "preload": "src/preload/preload.ts"
    },
    "format": [
      "cjs"
    ],
    "outDir": "dist/main",
    "splitting": false,
    "minify": false,
    "sourcemap": true,
    "dts": false,
    "clean": true,
    "external": [
      "electron"
    ]
  }
}
